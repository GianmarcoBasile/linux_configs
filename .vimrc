" Basic settings
set nocompatible
set tabstop=4
set shiftwidth=4
set expandtab
set autoindent
set smartindent
set termguicolors

syntax on
set background=dark

" Color palette
highlight Normal       guifg=#D8DEE9 guibg=#23272D
highlight Comment      guifg=#8296A5 gui=italic
highlight Type         guifg=#A3AD62
highlight Statement    guifg=#A3AD62
highlight String       guifg=#86AAA8
highlight Constant     guifg=#B48EAD
highlight Number       guifg=#B48EAD
highlight PreProc      guifg=#8296A5
highlight Identifier   guifg=#D8DEE9
highlight Function     guifg=#D8DEE9
highlight Special      guifg=#86AAA8
highlight EndOfBuffer guifg=#8296A5 guibg=#23272D
